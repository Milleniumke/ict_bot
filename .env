# Copy to .env and fill in
SYMBOLS=EURUSD=X,BTC-USD,GBPUSD=X
INTERVAL=15m
PERIOD=60d
POLL_SECONDS=300

# Alerts (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Broker: "paper" | "mt5"
BROKER=paper

# MT5 (only if BROKER=mt5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Storage
JOURNAL_DB=journal.sqlite
STATE_FILE=state.json
LOG_FILE=bot.log
